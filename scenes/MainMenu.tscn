[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/audio_synthesizer.gd" id="2_audio"]
[ext_resource type="Texture2D" path="res://assets/menu/Menu.jpg" id="3_bg"]
[ext_resource type="AudioStream" path="res://assets/sfx/FireCrackle.mp3" id="4_crackle"]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_menu")

[node name="AudioSynthesizer" type="Node" parent="."]
script = ExtResource("2_audio")

[node name="MusicPlayer" type="AudioStreamPlayer" parent="."]
bus = &"Master"

[node name="FireCrackle" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_crackle")
volume_db = -14.0
autoplay = true
bus = &"Master"

[node name="Background" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("3_bg")
expand_mode = 1
stretch_mode = 6

[node name="FireFX" type="Node2D" parent="."]

[node name="UI" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Buttons" type="VBoxContainer" parent="UI"]
offset_left = 50.0
offset_top = 214.0
offset_right = 380.0
offset_bottom = 553.0
theme_override_constants/separation = 21

[node name="StartButton" type="Button" parent="UI/Buttons"]
custom_minimum_size = Vector2(330, 51)
text = "Start Solo Run"

[node name="HostButton" type="Button" parent="UI/Buttons"]
custom_minimum_size = Vector2(330, 51)
text = "Host Co-op Lobby"

[node name="JoinButton" type="Button" parent="UI/Buttons"]
custom_minimum_size = Vector2(330, 51)
text = "Join Game"

[node name="ControlsButton" type="Button" parent="UI/Buttons"]
custom_minimum_size = Vector2(330, 51)
text = "Controls & Settings"

[node name="QuitButton" type="Button" parent="UI/Buttons"]
custom_minimum_size = Vector2(330, 51)
text = "Quit to Desktop"

[node name="ControlsModal" type="Control" parent="UI"]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Dim" type="ColorRect" parent="UI/ControlsModal"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.6)

[node name="Center" type="CenterContainer" parent="UI/ControlsModal"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="UI/ControlsModal/Center"]

[node name="VBox" type="VBoxContainer" parent="UI/ControlsModal/Center/Panel"]
custom_minimum_size = Vector2(500, 0)
theme_override_constants/separation = 10

[node name="TitleC" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 30
text = "Controls"
horizontal_alignment = 1

[node name="Move" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[W] [A] [S] [D]  —  Move Character"

[node name="Interact" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[E]  —  Interact / Pivot Prism"

[node name="MirrorControl" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[Mouse]  —  Swivel prism while pivoting or hauling"

[node name="Drop" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[G]  —  Drop / Set Down"

[node name="RotateCam" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[Q]  —  Rotate Camera 90°"

[node name="Emote" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[B]  —  Emote Wheel (hold)"

[node name="Notes" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[Tab]  —  Notes"

[node name="Ping" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[F]  —  Ping Location (co-op)"

[node name="Esc" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[ESC]  —  Pause / Close Minigame"

[node name="Restart" type="Label" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_font_sizes/font_size = 18
text = "[R]  —  Quick Restart Run"

[node name="MusicRow" type="HBoxContainer" parent="UI/ControlsModal/Center/Panel/VBox"]
theme_override_constants/separation = 12

[node name="MusicLabel" type="Label" parent="UI/ControlsModal/Center/Panel/VBox/MusicRow"]
theme_override_font_sizes/font_size = 18
text = "Music Volume:"

[node name="MusicVolumeSlider" type="HSlider" parent="UI/ControlsModal/Center/Panel/VBox/MusicRow"]
custom_minimum_size = Vector2(180, 0)
size_flags_horizontal = 3
size_flags_vertical = 4
value = 30.0
min_value = 0.0
max_value = 100.0
step = 5.0

[node name="CloseControlsButton" type="Button" parent="UI/ControlsModal/Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 46)
text = "Back"
