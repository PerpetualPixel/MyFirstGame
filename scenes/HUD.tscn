[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;
uniform float strength : hint_range(0.0, 1.0) = 0.3;
uniform vec4 tint : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float pulse = 0.0;
void fragment() {
	vec2 uv = UV - 0.5;
	float d = length(uv) * 1.5;
	float v = smoothstep(0.55, 1.15, d);
	COLOR = vec4(tint.rgb, v * (strength + pulse));
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = SubResource("Shader_vignette")
shader_parameter/strength = 0.3
shader_parameter/tint = Color(0, 0, 0, 1)
shader_parameter/pulse = 0.0

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Vignette" type="ColorRect" parent="."]
